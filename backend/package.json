{
  "name": "forca-agil-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend do Núcleo de Avaliação, Taxonomia e Mapa da Floresta — monólito modular NestJS (ambiente local).",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "npm run build && node --enable-source-maps dist/main.js",
    "migrar": "node dist/scripts/migrar.js",
    "test": "jest",
    "test:integracao": "jest --config jest.integracao.config.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verificar:ambiente": "node scripts/verificar-ambiente.js",
    "demonstrar:reinicio": "node scripts/demonstrar-reinicio.js"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "jose": "5.10.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.7",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "jest": "29.7.0",
    "supertest": "7.3.1",
    "ts-jest": "29.4.14",
    "typescript": "5.9.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "rootDir": ".",
    "testMatch": [
      "<rootDir>/test/**/*.spec.ts"
    ]
  }
}
