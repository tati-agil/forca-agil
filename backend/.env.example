# Copie para backend/.env e ajuste. O arquivo .env NÃO vai para o Git.
# Ambiente local com dados sintéticos: não use senhas reais nem dados da PREVI.
POSTGRES_DB=forca_agil
POSTGRES_USER=forca_agil
POSTGRES_PASSWORD=troque-por-uma-senha-local
API_PORTA=3000
BANCO_TIMEOUT_MS=2000

# Opcional: imagens de um espelho ou do registro corporativo (padrão: imagens oficiais do Docker Hub)
# POSTGRES_IMAGE=postgres:17-alpine
# NODE_IMAGE=node:22-alpine
